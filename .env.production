# --- SERVER SETTINGS ---
PORT=3000
NODE_ENV=production

# --- SECURITY ---
# IMPORTANT: Use a strong, unique, long string for JWT_SECRET
JWT_SECRET=replace_with_a_very_long_random_string_in_production

# --- DATABASE ---
# In production, use the service name from docker-compose.prod.yml (db)
POSTGRES_USER=ecom_admin
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=ecom_production
DATABASE_URL=postgresql://ecom_admin:generate_a_strong_password_here@db:5432/ecom_production?schema=public

# --- ADMIN DEFAULTS ---
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME="System Admin"

# --- LOGGING ---
LOG_LEVEL=warn

# --- EXTERNAL SERVICES ---
# Provide real API keys for production
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
