# --- SERVER SETTINGS ---
PORT=3000
NODE_ENV=production

# --- SECURITY ---
# IMPORTANT: Use a strong, unique, long string for JWT_SECRET
JWT_SECRET=replace_with_a_very_long_random_string_in_production

# --- DATABASE ---
# In production, use the service name from docker-compose.prod.yml (db)
POSTGRES_USER=websitedduniya
POSTGRES_PASSWORD=India@2026
POSTGRES_DB=websiteduniya
DATABASE_URL=postgresql://websitedduniya:India@2026@db:5432/websiteduniya?schema=public

# --- ADMIN DEFAULTS ---
